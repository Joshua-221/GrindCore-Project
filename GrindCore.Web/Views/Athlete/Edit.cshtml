@model GrindCore.Models.Athlete
@{
    ViewData["Title"] = "Editar Atleta";
}

<div class="container-fluid px-md-5 mt-5" style="padding-bottom: 6rem;">
    <div class="card-dark-custom p-5 mx-auto" style="max-width: 800px; border-top: 3px solid var(--brand-red) !important; background-color: #141619 !important; border: 1px solid #22252a !important;">
        
        <h2 class="mb-4 text-white" style="font-family: 'Orbitron', sans-serif; letter-spacing: 1px;">
            MODIFICAR PERFIL: @Model.Name
        </h2>
        
        <form action="@Url.Action("Edit", "Athlete")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row mb-4">
                <div class="col-12 col-md-6 mb-3">
                    <label class="text-uppercase fw-bold" style="font-size: 0.70rem; color: #9aa0a6; margin-bottom: 8px; display: block;">Nombre Completo</label>
                    <input type="text" name="Name" value="@Model.Name" class="form-control" style="background-color: #1a1d21 !important; border: 1px solid #2d2d34 !important; color: white !important; padding: 12px;" required />
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <label class="text-uppercase fw-bold" style="font-size: 0.70rem; color: #9aa0a6; margin-bottom: 8px; display: block;">Categoría</label>
                    <input type="text" name="Category" value="@Model.Category" class="form-control" style="background-color: #1a1d21 !important; border: 1px solid #2d2d34 !important; color: white !important; padding: 12px;" required />
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <label class="text-uppercase fw-bold" style="font-size: 0.70rem; color: #9aa0a6; margin-bottom: 8px; display: block;">Nivel</label>
                    <select name="ExperienceLevel" class="form-select" style="background-color: #1a1d21 !important; border: 1px solid #2d2d34 !important; color: white !important; padding: 12px;">
                        <option value="Principiante" selected="@(Model.ExperienceLevel == "Principiante")">Principiante</option>
                        <option value="Intermedio" selected="@(Model.ExperienceLevel == "Intermedio")">Intermedio</option>
                        <option value="Avanzado" selected="@(Model.ExperienceLevel == "Avanzado")">Avanzado</option>
                    </select>
                </div>
            </div>

            <h4 class="text-danger mb-4" style="font-family: 'Orbitron', sans-serif; font-size: 0.9rem; border-bottom: 1px solid #2d2d34; padding-bottom: 15px;">
                HISTORIAL DE CARGAS (1RM)
            </h4>
            
            <div class="row mb-5">
                <div class="col-4">
                    <label class="text-uppercase fw-bold" style="font-size: 0.70rem; color: #9aa0a6; margin-bottom: 8px; display: block;">Squat (kg)</label>
                    <input type="number" step="0.5" name="SquatPR" value="@Model.SquatPR" class="form-control" style="background-color: #1a1d21 !important; border: 1px solid #2d2d34 !important; color: white !important; padding: 12px;" required />
                </div>
                <div class="col-4">
                    <label class="text-uppercase fw-bold" style="font-size: 0.70rem; color: #9aa0a6; margin-bottom: 8px; display: block;">Bench (kg)</label>
                    <input type="number" step="0.5" name="BenchPR" value="@Model.BenchPR" class="form-control" style="background-color: #1a1d21 !important; border: 1px solid #2d2d34 !important; color: white !important; padding: 12px;" required />
                </div>
                <div class="col-4">
                    <label class="text-uppercase fw-bold" style="font-size: 0.70rem; color: #9aa0a6; margin-bottom: 8px; display: block;">Deadlift (kg)</label>
                    <input type="number" step="0.5" name="DeadliftPR" value="@Model.DeadliftPR" class="form-control" style="background-color: #1a1d21 !important; border: 1px solid #2d2d34 !important; color: white !important; padding: 12px;" required />
                </div>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-danger px-4 py-2 fw-bold" style="text-transform: uppercase;">Guardar Cambios</button>
                <a href="@Url.Action("Index", "Athlete")" class="btn btn-secondary px-4 py-2 fw-bold" style="background-color: #22252a; border: none; text-transform: uppercase;">Cancelar</a>
            </div>
        </form>
    </div>
</div>