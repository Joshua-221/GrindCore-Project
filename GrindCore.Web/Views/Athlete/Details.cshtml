@model GrindCore.Models.Athlete

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4" style="background-color: #121212; color: #fff; padding: 20px; border-radius: 8px;">
    <div class="border-bottom border-danger pb-3 mb-4 d-flex justify-content-between align-items-center">
        <h2 class="mb-0" style="font-weight: 800; text-transform: uppercase;">
            @Model.Name <span class="text-danger" style="font-size: 1.2rem;">(@Model.Category)</span>
        </h2>
        <a asp-action="Index" class="btn btn-outline-light btn-sm">&larr; Volver al Roster</a>
    </div>

    <div class="row">
        <div class="col-md-5 mb-4">
            <div class="card bg-dark text-white p-4" style="border: 1px solid #2d2d2d; border-left: 4px solid #dc3545;">
                <h4 class="mb-3 text-danger" style="text-transform: uppercase; font-weight: 700; font-size: 1.1rem;">Registrar Serie</h4>
                
                <form asp-action="LogWorkout" method="post">
                    <input type="hidden" name="athleteId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 0.8rem; text-transform: uppercase; color: #aaa;">Movimiento</label>
                        <select name="exercise" class="form-select bg-secondary text-white border-0">
                            <option value="Squat">Squat</option>
                            <option value="Bench Press">Bench Press</option>
                            <option value="Sumo Deadlift">Sumo Deadlift</option>
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label" style="font-size: 0.8rem; text-transform: uppercase; color: #aaa;">Sets</label>
                            <input type="number" name="sets" class="form-control bg-secondary text-white border-0" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label" style="font-size: 0.8rem; text-transform: uppercase; color: #aaa;">Reps</label>
                            <input type="number" name="reps" class="form-control bg-secondary text-white border-0" required />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <label class="form-label" style="font-size: 0.8rem; text-transform: uppercase; color: #aaa;">Peso (kg)</label>
                            <input type="number" step="0.1" name="weight" class="form-control bg-secondary text-white border-0" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label" style="font-size: 0.8rem; text-transform: uppercase; color: #aaa;">RPE</label>
                            <input type="number" step="0.5" name="rpe" class="form-control bg-secondary text-white border-0" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 fw-bold" style="text-transform: uppercase;">Guardar Registro</button>
                </form>
            </div>
        </div>

        <div class="col-md-7 mb-4">
            <div class="card bg-dark text-white p-4" style="border: 1px solid #2d2d2d;">
                <h4 class="mb-3" style="text-transform: uppercase; font-weight: 700; font-size: 1.1rem;">Historial de Hoy</h4>
                
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr style="font-size: 0.8rem; text-transform: uppercase; color: #aaa; border-bottom: 2px solid #3d3d3d;">
                                <th>Ejercicio</th>
                                <th>Esquema</th>
                                <th>Carga</th>
                                <th class="text-center">RPE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Logs != null && Model.Logs.Any())
                            {
                                foreach (var log in Model.Logs)
                                {
                                    <tr>
                                        <td class="text-danger fw-bold">@log.Exercise</td>
                                        <td>@log.Sets x @log.Reps</td>
                                        <td>@log.Weight kg</td>
                                        <td class="text-center">
                                            <span class="badge bg-warning text-dark fw-bold">@log.Rpe</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3" style="font-size: 0.9rem;">
                                        No hay series registradas para hoy.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>