@model GrindCore.Models.ScheduledSession

@{
ViewData["Title"] = "Calendario de Trabajo";

var fechaActual = Model != null
? Model.Date.ToDateTime(TimeOnly.MinValue)
: (ViewBag.SelectedDate != null ? (DateTime)ViewBag.SelectedDate : DateTime.Today);

var primerDiaMes = new DateTime(fechaActual.Year, fechaActual.Month, 1);
var diasEnMes = DateTime.DaysInMonth(fechaActual.Year, fechaActual.Month);
var espacioInicial = (int)primerDiaMes.DayOfWeek;

var athleteId = Model?.AthleteId ?? Convert.ToInt32(Context.Request.Query["athleteId"]);
var diasConRutina = ViewBag.DaysWithWorkouts as HashSet<DateTime> ?? new HashSet<DateTime>();
}

<style>
    /* Efecto de levantamiento individual para cada día del calendario */
    .day-hover-effect {
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        border: 1px solid #2d2d2d !important;
    }
    .day-hover-effect:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 10px rgba(0, 0, 0, 0.5) !important;
        border-color: #de1f26 !important;
        z-index: 10;
    }
    input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
</style>

<div class="container mt-4" style="padding-bottom: 6rem;">
    <div class="d-flex justify-content-between align-items-center border-bottom border-danger pb-3 mb-4">
        <h2 style="font-family: 'Orbitron', sans-serif;">Calendario: <span class="text-danger">@(ViewBag.AthleteName ?? "Atleta")</span></h2>
        <a asp-action="Index" class="btn btn-outline-light btn-sm">&larr; Volver al Roster</a>
    </div>

    <div class="row">
        <!-- Columna Izquierda: Calendario -->
        <div class="col-md-5 mb-4">
            <div class="card bg-dark text-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="mb-0 text-uppercase fw-bold">@fechaActual.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</h5>
                    <div>
                        <a href="?athleteId=@athleteId&date=@fechaActual.AddMonths(-1).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-danger me-1">&larr;</a>
                        <a href="?athleteId=@athleteId&date=@fechaActual.AddMonths(1).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-danger">&rarr;</a>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center;">
                    @foreach (var day in new[] { "DO", "LU", "MA", "MI", "JU", "VI", "SÁ" }) { <div class="text-muted small fw-bold">@day</div> }
                    @for (int i = 0; i < espacioInicial; i++) { <div></div> }
                    @for (int dia = 1; dia <= diasEnMes; dia++)
                    {
                    var loopDate = new DateTime(fechaActual.Year, fechaActual.Month, dia);
                    var tieneRutina = diasConRutina.Contains(loopDate.Date);
                    <a href="?athleteId=@athleteId&date=@loopDate.ToString("yyyy-MM-dd")"
                       class="btn btn-sm p-2 d-flex flex-column align-items-center justify-content-center position-relative day-hover-effect"
                       style="height: 44px; border-radius: 4px; background-color: @(loopDate.Date == fechaActual.Date ? "#dc3545" : "#1a1a1a"); color: #fff;">
                        <span>@dia</span>
                        @if (tieneRutina) { <span class="position-absolute" style="bottom: 5px; width: 5px; height: 5px; border-radius: 50%; background-color: #fff;"></span> }
                    </a>
                    }
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Formulario -->
        <div class="col-md-7 mb-4">
            <div class="card bg-dark text-white p-4">
                <h4 class="mb-3 text-danger text-uppercase fw-bold">Asignación: @fechaActual.ToString("dd/MM/yyyy")</h4>
                <form asp-action="SaveCalendarChanges" method="post">
                    <input type="hidden" name="AthleteId" value="@athleteId" />
                    <input type="hidden" name="Date" value="@fechaActual.ToString("yyyy-MM-dd")" />
                    <input type="text" name="Title" value="@Model?.Title" class="form-control bg-secondary text-white border-0 mb-4" placeholder="Nombre de la sesión" />

                    <h5 class="mb-3" style="font-size: 1rem; text-transform: uppercase; font-weight: 600;">Movimientos Programados</h5>
                    <div id="exercisesContainer">
                        @if (Model?.Exercises != null)
                        {
                        for (int i = 0; i < Model.Exercises.Count; i++)
                        {
                        <div class="d-flex gap-2 mb-3 align-items-center exercise-row">
                            <input type="text" name="Exercises[@i].Name" value="@Model.Exercises[i].Name" class="form-control bg-secondary text-white border-0" placeholder="Ejercicio" required />
                            <input type="number" name="Exercises[@i].Sets" value="@Model.Exercises[i].Sets" class="form-control bg-secondary text-white border-0 text-center" style="width: 72px;" placeholder="Sets" required />
                            <input type="number" name="Exercises[@i].Reps" value="@Model.Exercises[i].Reps" class="form-control bg-secondary text-white border-0 text-center" style="width: 72px;" placeholder="Reps" required />
                            <input type="number" step="0.1" name="Exercises[@i].Weight" value="@Model.Exercises[i].Weight" class="form-control bg-secondary text-white border-0 text-center" style="width: 85px;" placeholder="KG" required />
                            <input type="number" step="0.5" name="Exercises[@i].Rpe" value="@Model.Exercises[i].Rpe" class="form-control bg-secondary text-white border-0 text-center" style="width: 75px;" placeholder="RPE" required />
                            <button type="button" class="btn btn-outline-danger" onclick="removeExerciseRow(this)">&times;</button>
                        </div>
                        }
                        }
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-danger fw-bold" onclick="addExerciseRow()">+ AGREGAR EJERCICIO</button>
                        <button type="submit" class="btn btn-danger fw-bold px-4">GUARDAR CAMBIOS</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    let exerciseIndex = document.querySelectorAll('.exercise-row').length;
    function addExerciseRow() {
        const container = document.getElementById('exercisesContainer');
        const newRow = document.createElement('div');
        newRow.className = 'd-flex gap-2 mb-3 align-items-center exercise-row';
        newRow.innerHTML = `
            <input type="text" name="Exercises[${exerciseIndex}].Name" class="form-control bg-secondary text-white border-0" placeholder="Ejercicio" required />
            <input type="number" name="Exercises[${exerciseIndex}].Sets" class="form-control bg-secondary text-white border-0 text-center" style="width: 72px;" placeholder="Sets" required />
            <input type="number" name="Exercises[${exerciseIndex}].Reps" class="form-control bg-secondary text-white border-0 text-center" style="width: 72px;" placeholder="Reps" required />
            <input type="number" step="0.1" name="Exercises[${exerciseIndex}].Weight" class="form-control bg-secondary text-white border-0 text-center" style="width: 85px;" placeholder="KG" required />
            <input type="number" step="0.5" name="Exercises[${exerciseIndex}].Rpe" class="form-control bg-secondary text-white border-0 text-center" style="width: 75px;" placeholder="RPE" required />
            <button type="button" class="btn btn-outline-danger" onclick="removeExerciseRow(this)">&times;</button>
        `;
        container.appendChild(newRow);
        exerciseIndex++;
    }
    function removeExerciseRow(btn) { btn.closest('.exercise-row').remove(); }
</script>