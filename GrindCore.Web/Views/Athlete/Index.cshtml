@model IEnumerable<GrindCore.Models.Athlete>

@{
ViewData["Title"] = "Panel de Atletas";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Efecto de levantamiento para tarjetas */
    .card-hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #2d2d2d;
    }
    .card-hover-effect:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5) !important;
        border-color: #de1f26 !important;
    }

    /* Animación para iconos al pasar el cursor sobre su contenedor */
    .btn-square-menu {
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .btn-square-menu:hover i {
        transform: scale(1.2);
    }

    /* Efecto para el botón Registrar Atleta */
    .btn-register-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .btn-register-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4) !important;
    }
</style>

<div class="container-fluid px-md-5 mt-4" style="padding-bottom: 6rem;">

    <!-- Encabezado -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center p-4 mb-5 card-dark-custom">
        <div>
            <h2 class="mb-1" style="font-family: 'Orbitron', sans-serif; font-weight: 900; letter-spacing: 1px;">
                PANEL DE CONTROL DE ATLETAS
            </h2>
            <p style="color: var(--text-gray); margin: 0; font-size: 0.9rem;">
                Administración de bloques de fuerza, récords personales y planificación RPE.
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-danger px-4 py-2 fw-bold btn-register-hover" style="font-size: 0.85rem;">
                <i class="bi bi-person-plus-fill me-2"></i> REGISTRAR NUEVO ATLETA
            </a>
        </div>
    </div>

    <!-- Malla de Atletas -->
    <div class="row g-4 justify-content-center">
        @foreach (var athlete in Model)
        {
        <div class="col-12 col-md-6 col-lg-4 col-xxl-3">
            <div class="card-dark-custom card-hover-effect" style="border-top: 3px solid #de1f26 !important;">

                <h4 class="text-white fw-bold">@athlete.Name</h4>
                <p class="small" style="color: #adb5bd; font-weight: 500;">Nivel: <span class="text-white">@athlete.ExperienceLevel</span></p>

                <div class="row g-2">
                    <div class="col-6">
                        <a asp-action="Details" asp-route-id="@athlete.Id" class="btn-square-menu">
                            <i class="bi bi-person-bounding-box icon-profile"></i>Perfil
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-action="Calendar" asp-route-athleteId="@athlete.Id" class="btn-square-menu">
                            <i class="bi bi-calendar3 icon-routine"></i>Rutina
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-action="Edit" asp-route-id="@athlete.Id" class="btn-square-menu">
                            <i class="bi bi-sliders icon-prs"></i>Editar PRs
                        </a>
                    </div>
                    <div class="col-6">
                        <a asp-action="ProgrammedRoutine" asp-route-athleteId="@athlete.Id" class="btn-square-menu">
                            <i class="bi bi-journal-text icon-active"></i>Rutina Activa
                        </a>
                    </div>
                </div>

                <!-- Botón de Eliminar con confirmación -->
                <div class="mt-3 pt-3 border-top border-secondary">
                    <form asp-action="Delete" asp-route-id="@athlete.Id" method="post" 
                          onsubmit="return confirm('¿Seguro que deseas eliminar a @athlete.Name?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </form>
                </div>
            </div>
        </div>
        }
    </div>
</div>