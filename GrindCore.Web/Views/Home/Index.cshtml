@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid px-md-5 mt-5">
    <div class="iron-card text-center d-flex flex-column justify-content-center align-items-center" style="min-height: 70vh; background: radial-gradient(circle at 50% 50%, #161616, #080808) !important;">
        
        <!-- Elemento decorativo: Silueta de disco/barra con CSS puro -->
        <div class="barbell-icon-wrapper mb-4">
            <div class="iron-disc left-disc"></div>
            <div class="iron-bar"></div>
            <div class="iron-disc right-disc"></div>
        </div>

        <!-- Título Masivo Estilo Competencia -->
        <h1 class="display-1 mb-2" style="font-family: 'Orbitron', sans-serif; font-weight: 900; letter-spacing: -2px; text-transform: uppercase; text-shadow: 0 0 30px rgba(220, 53, 69, 0.3);">
            GRIND <span class="text-danger" style="color: #dc3545;">CORE</span>
        </h1>
        
        <p class="lead text-muted mb-5" style="font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; max-width: 600px; letter-spacing: 0.5px;">
            SISTEMA DE GESTIÓN DE FUERZA Y PROGRAMACIÓN RPE 10
        </p>

        <div class="border-top border-secondary w-50 my-4" style="opacity: 0.2;"></div>

        <p class="text-light mb-5" style="max-width: 650px; font-size: 1.1rem; color: #aaa !important;">
            Control absoluto de levantadores, gestión estricta de bloques de carga y registro preciso de cada kilogramo en la barra. No dejes espacio al fallo.
        </p>

        <!-- Botón de Acción con Transición Pesada -->
        <a asp-controller="Athlete" asp-action="Index" class="btn btn-danger btn-lg px-5 py-3 fw-bold shadow-lg" style="font-size: 1.2rem; letter-spacing: 1px; border-radius: 6px;">
            ENTRAR AL PANEL DE ATLETAS &rarr;
        </a>
    </div>
</div>

<!-- Estilos específicos para el arte de la barra olímpica de fondo -->
<style>
    .barbell-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.7;
        transform: scale(1.2);
        animation: pulseGlow 3s infinite ease-in-out;
    }
    .iron-bar {
        width: 120px;
        height: 6px;
        background: linear-gradient(90deg, #333, #888, #333);
    }
    .iron-disc {
        width: 16px;
        height: 45px;
        background: #222;
        border: 2px solid #333;
        border-radius: 4px;
        position: relative;
    }
    .iron-disc::after {
        content: '';
        position: absolute;
        top: 5px; left: 2px; right: 2px; bottom: 5px;
        border: 1px solid #dc3545;
        border-radius: 2px;
    }
    @@keyframes pulseGlow {
        0%, 100% { filter: drop-shadow(0 0 5px rgba(220, 53, 69, 0)); }
        50% { filter: drop-shadow(0 0 15px rgba(220, 53, 69, 0.4)); }
    }
</style>